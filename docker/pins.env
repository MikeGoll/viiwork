# The engine pins, in one place. Sourced by scripts/gobuild.sh (the llama.cpp
# pin is stamped into every binary) and scripts/release-images.sh, and checked
# against the Dockerfiles' ARG defaults by scripts/pins_test.sh.

# The llama.cpp release the fleet builds (docker/Dockerfile.rocm) and a Mac
# downloads (scripts/macos/fetch-llama.sh, the setup wizard).
LLAMA_CPP_VERSION=b11609

# The sha256 of llama-<LLAMA_CPP_VERSION>-bin-macos-arm64.tar.gz, stamped into
# every binary beside the pin: a Mac fetches its llama.cpp by this digest from
# the asset's fixed URL, so the release signature covers the engine too.
# Change it with LLAMA_CPP_VERSION, from the release's asset list.
LLAMA_CPP_MACOS_SHA256=d03f28b5a5baa9cdfbb01db5ed22c695126c11c193326f14cdc51d001be10f4e

# The nearest llama.cpp build at or after LLAMA_CPP_VERSION for which upstream
# publishes server-cuda and server-vulkan images (not every build has them;
# b11609 does not, b11610 does: its one extra commit is a SYCL build fix). The
# published viiwork-llamacpp-* images sit on it.
LLAMA_CPP_IMAGE_BUILD=b11610

# The vLLM image viiwork-vllm sits on (docker/Dockerfile.vllm).
VLLM_VERSION=v0.31.0

# The Strata release both viiwork-strata images build (docker/Dockerfile.strata,
# docker/Dockerfile.strata-cuda). The gfx906 patch in docker/strata/ is named
# for this version and must be re-cut when it changes.
STRATA_VERSION=v0.1.44.1
# The commit that tag names. A tag can be moved; both images check out the tag
# and then refuse anything but this commit. Upstream rewrote its history on
# 2026-10-06, which moved every tag: the v0.1.39 pin of v2.8.0 to v2.8.2
# (6f32ec07) no longer builds.
STRATA_COMMIT=296b59d2f73c8f04a805df29c2fa97655adace78

# The ROCm base viiwork-strata builds on. AMD's own ROCm no longer ships gfx906
# libraries; this is the community image Strata's docs name, held by digest
# because its tag can move.
STRATA_ROCM_BASE=mixa3607/rocm-gfx906:7.14-complete@sha256:622c025824d465faa0f5e59eea4f723845032011df273c3b11e25031965fc428
