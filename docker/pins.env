# The engine pins, in one place. Sourced by scripts/gobuild.sh (the llama.cpp
# pin is stamped into every binary) and scripts/release-images.sh, and checked
# against the Dockerfiles' ARG defaults by scripts/pins_test.sh.

# The llama.cpp release the fleet builds (docker/Dockerfile.rocm) and a Mac
# downloads (scripts/macos/fetch-llama.sh, the setup wizard).
LLAMA_CPP_VERSION=b10437

# The nearest llama.cpp build at or after LLAMA_CPP_VERSION for which upstream
# publishes server-cuda and server-vulkan images (b10437 has none). The
# published viiwork-llamacpp-* images sit on it.
LLAMA_CPP_IMAGE_BUILD=b10438

# The vLLM image viiwork-vllm sits on (docker/Dockerfile.vllm).
VLLM_VERSION=v0.11.2
