# viiwork on Strata, CUDA.
#
# Since 0.2.1 upstream publishes ready-made images
# (ghcr.io/niko1221/strata:<version>-<flavor>), so this is the same shape as
# Dockerfile.vllm: the pinned upstream image (STRATA_CUDA_IMAGE in
# docker/pins.env, held by digest) with viiwork dropped in. Nothing is
# compiled. The cuda13 flavor needs NVIDIA driver 580 or newer; its engine is
# built for sm_75, 86, 89 and 120 (RTX 20 to 50, A4000), plus PTX.
#
# The 0.2 layout is not the 0.1.x one. The server and its Python are in the
# Terminal, so the model's block is
#   strata: {dir: /opt/strata/terminal, python: /opt/strata/terminal/python/bin/python3}
# and the engine is an installed component package: the Strata JSON's "exe" is
#   /opt/strata/components/engine/0.1.48-linux-x86_64-cuda-cuda13/strata
# with that directory in "lib_dirs" (its CUDA libraries are beside it) and
# "cwd": "/opt/strata/terminal". With the 0.1.x paths the backend dies at launch.
#
# Served under viiwork on an RTX 5090 (tehas-white, 2026-10-23, kv_share's
# kv-export-0.2 build of the same layout) and on an RTX A4000 at 0.2.3
# (2026-10-24). Earlier pins, built from source: v0.1.39 to v0.1.45 on three
# RTX A4000 at 262,144 context, two RTX 4090 and an RTX 5090.
# nvidia-smi is injected by the container runtime, as in Dockerfile.vllm.

ARG STRATA_CUDA_IMAGE=ghcr.io/niko1221/strata:0.2.3-cuda13@sha256:d39ca9fc583c5085dc66b857fbf3b3e3a9e256f692672d4061322d3bd468433a

FROM golang:1.27.2 AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION}" -o /viiwork ./cmd/viiwork

FROM ${STRATA_CUDA_IMAGE}

# Upstream's entrypoint (tini, then entrypoint.sh) prepares /data and starts
# one server. viiwork is the process here and starts the servers itself.
ENTRYPOINT []
# Upstream's healthcheck probes port 8080, which nothing listens on here.
HEALTHCHECK NONE

RUN apt-get update \
    && apt-get install -y --no-install-recommends ipmitool \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-build /viiwork /usr/local/bin/

WORKDIR /
EXPOSE 8086/tcp 7946/tcp 7946/udp
CMD ["viiwork", "--config", "/etc/viiwork/viiwork.yaml"]
