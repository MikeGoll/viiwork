index 5af9b68..25fb5a6 100644
--- a/include/strata/platform/hip_compat/strata_hip.h
+++ b/include/strata/platform/hip_compat/strata_hip.h
@@ -42,6 +42,8 @@
 #define cudaMemcpyDeviceToDevice hipMemcpyDeviceToDevice
 #define cudaMemcpyDefault hipMemcpyDefault
 #define cudaStreamNonBlocking hipStreamNonBlocking
+#define cudaDeviceGetStreamPriorityRange hipDeviceGetStreamPriorityRange
+#define cudaStreamCreateWithPriority hipStreamCreateWithPriority
 #define cudaStreamCaptureModeThreadLocal hipStreamCaptureModeThreadLocal
 #define cudaStreamCaptureModeRelaxed hipStreamCaptureModeRelaxed
 #define cudaStreamCaptureModeGlobal hipStreamCaptureModeGlobal
diff --git a/src/core/conversation_state.cpp b/src/core/conversation_state.cpp
index ae40f3a..6846f57 100644
--- a/src/core/conversation_state.cpp
+++ b/src/core/conversation_state.cpp
@@ -32,7 +32,22 @@ bool sync(std::string& error) {
 bool copy(void* dst, const void* src, size_t bytes, std::string& error) {
     if (!bytes) return true;
     if (!dst || !src) return fail(error, "missing running-state buffer");
+#if defined(STRATA_HIP_GFX906)
+    // HIP refuses a copy on the default stream while any stream captures a graph, whatever capture mode that stream
+    // asked for (CUDA's thread-local mode lets it through), and the refused copy also invalidates that capture.
+    // Another thread captures its prompt graphs while this one saves a checkpoint, so the first long prompt after a
+    // load ended in "saving a checkpoint part failed".  A stream of this thread's own, per device, is no part of
+    // any capture.
+    thread_local cudaStream_t own[64] = {};
+    int dev = -1;
+    auto status = cudaGetDevice(&dev);
+    if (status == cudaSuccess && (dev < 0 || dev >= 64)) status = hipErrorInvalidValue;
+    if (status == cudaSuccess && !own[dev]) status = cudaStreamCreateWithFlags(&own[dev], cudaStreamNonBlocking);
+    if (status == cudaSuccess) status = cudaMemcpyAsync(dst, src, bytes, cudaMemcpyDefault, own[dev]);
+    if (status == cudaSuccess) status = cudaStreamSynchronize(own[dev]);
+#else
     const auto status = cudaMemcpy(dst, src, bytes, cudaMemcpyDefault);
+#endif
     if (status == cudaSuccess) return true;
     error = std::string("conversation snapshot running-state copy: ") + cudaGetErrorString(status);
     return false;
